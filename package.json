{
  "name": "zombie-base-defense",
  "private": true,
  "scripts": {
    "build:sprites": "node tools/build-sprite-atlas.mjs",
    "dev": "pnpm --filter @zbd/desktop dev",
    "dev:relay": "pnpm --filter @zbd/relay dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "smoke:sim": "pnpm --filter @zbd/sim smoke"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "sharp": "0.33.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
