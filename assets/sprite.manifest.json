    { "key": "zombie", "file": "sprites/zombie.png" },
    { "key": "base", "file": "sprites/base.png" },
    { "key": "wall", "file": "sprites/wall.png" },
    { "key": "turret", "file": "sprites/turret.png" },
    { "key": "projectile", "file": "sprites/projectile.png" },
    { "key": "weapon_icon", "file": "sprites/weapon_icon.png" }
  ]
}
